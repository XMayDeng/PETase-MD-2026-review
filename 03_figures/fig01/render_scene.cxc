# Refine Figure 1: active-site architecture in sequence-matched experimental structures.
close
open @PACKAGE@/01_simulation/inputs/reference_structures/6EQD.pdb
open @PACKAGE@/01_simulation/inputs/reference_structures/7QJR.pdb
open @PACKAGE@/01_simulation/inputs/reference_structures/4EB0.pdb
open @PACKAGE@/01_simulation/inputs/reference_structures/5AJH.pdb
open @PACKAGE@/01_simulation/inputs/reference_structures/4OYY.pdb
open @PACKAGE@/01_simulation/inputs/reference_structures/7NEI.pdb
matchmaker #2/A to #1/A
matchmaker #3/A to #1/A
matchmaker #4/A to #1/A
matchmaker #5/A to #1/A
matchmaker #6/A to #1/A
cartoon #1-6/A
set bgColor white
lighting soft
graphics silhouettes true
hide #1-6 atoms
hide /B-Z cartoons
color #1-6/A #D8DDE2 cartoons
view #1-6/A
turn y 31
turn x -11
hide #1-6 models
# IsPETase (6EQD)
show #1 models
show #1/A:160,206,237 atoms
style #1/A:160,206,237 stick
size #1/A:160,206,237 stickRadius 0.24
color #1/A:160,206,237 #E07B54 atoms
hide #1/A:160,206,237@H* atoms
show #1/A:185 atoms
style #1/A:185 stick
size #1/A:185 stickRadius 0.25
color #1/A:185 #E8C547 atoms
hide #1/A:185@H* atoms
view #1/A pad 0.08
save @WORK@/Figure_01_IsPETase_context.png width 1800 height 1800 supersample 3 transparentBackground false
size #1/A:160,206,237 stickRadius 0.26
color #1/A #B6BEC8 cartoons
transparency #1/A 30 target c
view #1/A:160,206,237,185 pad 0.08
zoom 1.28
size #1/A:185 stickRadius 0.27
label #1/A:160 residues text "S160" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset 0.8,0.8,0.5
label #1/A:206 residues text "D206" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset 0.8,-1.6,0.5
label #1/A:237 residues text "H237" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset -3.0,-0.7,0.5
label #1/A:185 residues text "W185" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset -4.0,0.8,0.5
runscript @PACKAGE@/03_figures/fig01/project_labels.py
save @WORK@/Figure_01_IsPETase_active_site.png width 2100 height 1800 supersample 3 transparentBackground false
label delete
hide #1 models
# TfCut1 (7QJR)
show #2 models
show #2/A:131,177,209 atoms
style #2/A:131,177,209 stick
size #2/A:131,177,209 stickRadius 0.24
color #2/A:131,177,209 #E07B54 atoms
hide #2/A:131,177,209@H* atoms
show #2/A:156 atoms
style #2/A:156 stick
size #2/A:156 stickRadius 0.25
color #2/A:156 #E8C547 atoms
hide #2/A:156@H* atoms
view #2/A pad 0.08
save @WORK@/Figure_01_TfCut1_context.png width 1800 height 1800 supersample 3 transparentBackground false
size #2/A:131,177,209 stickRadius 0.26
color #2/A #B6BEC8 cartoons
transparency #2/A 30 target c
view #2/A:131,177,209,156 pad 0.08
zoom 1.28
size #2/A:156 stickRadius 0.27
label #2/A:131 residues text "S131" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset 0.8,0.8,0.5
label #2/A:177 residues text "D177" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset 0.8,-1.6,0.5
label #2/A:209 residues text "H209" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset -3.0,-0.7,0.5
label #2/A:156 residues text "W156" height fixed size 14 font "DejaVu Sans" color #161A20 bgColor #FFFFFFCC offset 0.8,0.8,0.5
runscript @PACKAGE@/03_figures/fig01/project_labels.py
save @WORK@/Figure_01_TfCut1_active_site.png width 2100 height 1800 supersample 3 transparentBackground false
label delete
hide #2 models
