; build_system.py config (mdp-style key=value)
; Notes:
; - Paths can be absolute or relative to 01_simulation/.
; - Supply the protein explicitly with --protein or a protein= entry.
; - These settings are read by build_system.py, not directly by grompp.

gmx_bin       = gmx      ; gmx_mpi, gmx, or absolute path

ff_dir        = inputs/forcefields/charmm36-jul2021.ff  ; protein force-field directory

pet_choice    = PET_L20  ; PET subdirectory used to fill the paths below
;pet_gro       = PET_data/PET_L20/gromacs/step3_input.gro    ; PET coordinates from CHARMM-GUI
;pet_itp       = PET_data/PET_L20/gromacs/toppar/P1.itp      ; PET molecular topology
;ff_itp        = PET_data/PET_L20/gromacs/toppar/forcefield.itp        ; additional CHARMM-GUI parameters


mdp_dir       = configurations/templates/md      ; templates, including ions.mdp
outdir        = code/system_build                ; system-building output directory

; System build settings
salt          = 0.1          ; ion concentration in M
water         = tip3p        ; water model for pdb2gmx
water_coord   = spc216.gro   ; water coordinate file for solvate
box_type      = triclinic    ; editconf box type
box_distance  = 1.0          ; baseline distance from solute to box edge (nm)
auto_box      = suggest      ; off/suggest/apply: suggest/apply box_distance from protein+PET dimensions
pbc_buffer    = 1.2          ; target minimum-image buffer for auto_box (nm)
;insert_seed   = 20260209     ; fixed insert-molecules seed; omit for a random seed
;genion_seed   = 20260209     ; fixed genion seed; omit for a random seed

; genion behavior
genion_group  = SOL          ; solvent group name in genion

; Forcefield handling (copy into system_build)
copy_ff       = no           ; yes/no

; Post-build sanity check
post_check    = yes          ; yes/no: run check_system_build.py after building
check_strict  = no           ; yes/no: yes returns nonzero for WARN as well as FAIL
